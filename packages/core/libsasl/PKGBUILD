# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=libsasl
pkgver=2.1.28
pkgrel=1
pkgdesc="Cyrus Simple Authentication Service Layer (SASL) library"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://www.cyrusimap.org/sasl/"
license=('BSD-4-Clause-UC')
depends=('gdbm' 'openssl')
provides=('cyrus-sasl-libs' 'libsasl2.dylib=3')
options=('!strip' '!libtool')
source=("https://github.com/cyrusimap/cyrus-sasl/releases/download/cyrus-sasl-${pkgver}/cyrus-sasl-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/cyrus-sasl-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk} -Wno-implicit-function-declaration -Wno-incompatible-pointer-types"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    ./configure \
        --prefix=/opt/pacman \
        --sysconfdir=/opt/pacman/etc \
        --mandir=/opt/pacman/share/man \
        --with-plugindir=/opt/pacman/lib/sasl2 \
        --with-configdir=/opt/pacman/etc/sasl2 \
        --with-dblib=gdbm \
        --with-openssl=/opt/pacman \
        --disable-macos-framework \
        --disable-gssapi \
        --disable-krb4 \
        --disable-otp \
        --disable-srp \
        --enable-login \
        --enable-plain \
        --enable-cram \
        --enable-digest \
        --enable-scram \
        --enable-shared \
        --disable-static

    make -j1
}

package() {
    cd "$srcdir/cyrus-sasl-${pkgver}"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
