# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=unixodbc
pkgver=2.3.12
pkgrel=1
pkgdesc="ODBC is an open specification for providing application developers with a predictable API to access Data Sources"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://www.unixodbc.org/"
license=('LGPL-2.1-or-later AND GPL-2.0-or-later')
depends=('libtool' 'readline')
provides=('libodbc.dylib=2' 'libodbccr.dylib=2' 'libodbcinst.dylib=2')
options=('!strip' '!libtool')
source=("https://github.com/lurcher/unixODBC/releases/download/${pkgver}/unixODBC-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/unixODBC-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk} -liconv"

    ./configure \
        --prefix=/opt/pacman \
        --sysconfdir=/opt/pacman/etc \
        --mandir=/opt/pacman/share/man \
        --enable-shared \
        --disable-static

    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/unixODBC-${pkgver}"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
