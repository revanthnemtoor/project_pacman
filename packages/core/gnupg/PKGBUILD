pkgname=gnupg
pkgver=2.5.24
pkgrel=2
pkgdesc="GNU Privacy Guard (OpenPGP)"

url="https://gnupg.org/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'GPL-3.0-or-later'
)
depends=(
    'gettext'
    'gnutls'
    'libassuan'
    'libgcrypt'
    'libgpg-error'
    'libksba'
    'libusb'
    'npth'
    'pinentry'
    'readline'
)
makedepends=(
    'pkgconf'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}