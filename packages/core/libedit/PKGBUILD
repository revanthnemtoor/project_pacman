# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=libedit
pkgver=20250104_3.1
_tarver=20250104-3.1
pkgrel=1
pkgdesc="Command line editor library providing generic line editing, history, and tokenization functions"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://thrysoee.dk/editline/"
license=('BSD-3-Clause')
depends=('ncurses')
provides=('libedit.dylib=0')
options=('!strip' '!libtool')
source=("https://thrysoee.dk/editline/libedit-${_tarver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/libedit-${_tarver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    ./configure \
        --prefix=/opt/pacman \
        --mandir=/opt/pacman/share/man \
        --enable-widec \
        --enable-shared \
        --disable-static

    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/libedit-${_tarver}"
    make DESTDIR="$pkgdir" install
    # Avoid man3/history.3 conflict with readline
    rm -f "$pkgdir/opt/pacman/share/man/man3/history.3"* 2>/dev/null || true
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
