# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=leancrypto
pkgver=1.3.0
pkgrel=1
pkgdesc="Lean cryptographic library usable for bare-metal and POSIX environments (PQC ML-KEM / ML-DSA)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://leancrypto.org/"
license=('GPL-2.0-or-later OR BSD-3-Clause')
provides=('libleancrypto.dylib=1')
options=('!strip' '!libtool')
source=("leancrypto-${pkgver}.tar.gz::https://github.com/smuellerDD/leancrypto/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/leancrypto-${pkgver}"
    python3 -c '
p = "meson.build"
t = open(p).read()
t = t.replace("host_machine.system() != '\''windows'\''", "host_machine.system() != '\''windows'\'' and host_machine.system() != '\''darwin'\''")
open(p, "w").write(t)
'
}

build() {
    cd "$srcdir/leancrypto-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    meson setup build \
        --prefix=/opt/pacman \
        --libdir=lib \
        --buildtype=release \
        --default-library=shared \
        -Dapps=disabled

    ninja -C build
}

package() {
    export PATH="/opt/pacman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    cd "$srcdir/leancrypto-${pkgver}"
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm644 LICENSE.bsd "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE" 2>/dev/null || \
        install -Dm644 LICENSE "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
