# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=readline
pkgver=8.2.13
pkgrel=1
pkgdesc="GNU readline library"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://tiswww.case.edu/php/chet/readline/rltop.html"
license=('GPL-3.0-or-later')
depends=('ncurses')
options=('!strip')
source=("https://ftpmirror.gnu.org/gnu/readline/readline-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/readline-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"
    ./configure --prefix=/opt/pacman --with-curses --enable-multibyte --disable-static --enable-shared
    make SHLIB_LIBS="-L/opt/pacman/lib -lncursesw" -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/readline-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    make DESTDIR="$pkgdir" install
    rm -f "$pkgdir/opt/pacman/share/info/dir"
    /opt/pacman/bin/install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
