# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
# Native macOS port for Pacman (/opt/pacman)
pkgname=curl
pkgver=8.23.0
pkgrel=2
pkgdesc="Command line tool and library for transferring data with URLs"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://curl.se/"
license=('MIT')
depends=('ca-certificates' 'brotli' 'libidn2' 'libnghttp2' 'libpsl' 'libssh2' 'openssl' 'zlib' 'zstd')
provides=('libcurl.dylib=4' 'libcurl.so=4-64')
options=('!strip' '!libtool')
source=("https://curl.se/download/curl-${pkgver}.tar.xz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/curl-${pkgver}"
    # On macOS, when Apple SecTrust + Pacman CA bundle (/opt/pacman/etc/ssl/cert.pem) are built-in,
    # ignore stale generic SSL_CERT_FILE=/etc/ssl/cert.pem overrides so Apple Keychain SecTrust
    # and /opt/pacman/etc/ssl/cert.pem both stay active automatically.
    python3 -c '
p = "src/tool_operate.c"
txt = open(p).read()
old = """      env = curl_getenv("SSL_CERT_FILE");
      if(env) {"""
new = """      env = curl_getenv("SSL_CERT_FILE");
      if(env && strcmp(env, "/etc/ssl/cert.pem") == 0) {
        curl_free(env);
        env = NULL;
      }
      if(env) {"""
assert old in txt, "Pattern not found in src/tool_operate.c"
open(p, "w").write(txt.replace(old, new, 1))
'
}

build() {
    cd "$srcdir/curl-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"

    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CXX="/usr/bin/clang++"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export CXXFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    ./configure \
        --prefix=/opt/pacman \
        --sysconfdir=/opt/pacman/etc \
        --mandir=/opt/pacman/share/man \
        --enable-shared \
        --disable-static \
        --enable-ipv6 \
        --enable-threaded-resolver \
        --enable-websockets \
        --disable-ldap \
        --disable-ldaps \
        --without-apple-idn \
        --with-openssl=/opt/pacman \
        --with-apple-sectrust \
        --with-ca-bundle=/opt/pacman/etc/ssl/cert.pem \
        --with-ca-fallback \
        --with-nghttp2=/opt/pacman \
        --with-libssh2=/opt/pacman \
        --with-libidn2=/opt/pacman \
        --with-libpsl \
        --with-brotli=/opt/pacman \
        --with-zstd=/opt/pacman \
        --with-zlib=/opt/pacman

    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/curl-${pkgver}"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"

    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
