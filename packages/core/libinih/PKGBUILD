# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=libinih
pkgver=59
pkgrel=1
pkgdesc="A simple .INI file parser written in C"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/benhoyt/inih"
license=('BSD-3-Clause')
provides=('libinih.dylib=0' 'libINIReader.dylib=0')
options=('!strip' '!libtool')
source=("inih-r${pkgver}.tar.gz::https://github.com/benhoyt/inih/archive/refs/tags/r${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/inih-r${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CXX="/usr/bin/clang++"
    export CFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export CXXFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    /usr/local/bin/meson setup build \
        --prefix=/opt/pacman \
        --libdir=lib \
        --buildtype=release \
        --default-library=shared \
        -Ddistro_install=true \
        -Dwith_INIReader=true

    /usr/local/bin/ninja -C build
}

package() {
    cd "$srcdir/inih-r${pkgver}"
    DESTDIR="$pkgdir" /usr/local/bin/ninja -C build install
    install -Dm644 LICENSE.txt "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
