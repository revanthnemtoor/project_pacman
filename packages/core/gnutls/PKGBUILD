pkgname=gnutls
pkgver=3.8.13
pkgrel=3
pkgdesc="GNU Transport Layer Security (TLS) Library"

url="https://gnutls.org/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'LGPL-2.1-or-later AND GPL-3.0-only'
)
depends=(
    'ca-certificates'
    'gettext'
    'gmp'
    'libidn2'
    'libtasn1'
    'libunistring'
    'nettle'
    'p11-kit'
)
makedepends=(
    'pkgconf'
    'texinfo'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}