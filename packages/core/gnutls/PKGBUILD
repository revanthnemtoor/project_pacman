# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=gnutls
pkgver=3.8.9
pkgrel=1
pkgdesc="A library which provides a secure layer over a reliable transport layer"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://www.gnutls.org/"
license=('GPL-3.0-or-later AND LGPL-2.1-or-later')
depends=('gmp' 'libidn2' 'libtasn1' 'libunistring' 'nettle' 'p11-kit' 'zlib' 'zstd' 'brotli')
options=('!strip')
source=("https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/gnutls-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CC="/usr/bin/clang"
    export CXX="/usr/bin/clang++"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export CXXFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -framework Security -framework CoreFoundation -isysroot ${_sdk}"

    ./configure \
        --prefix=/opt/pacman \
        --with-default-trust-store-file=/opt/pacman/etc/ssl/cert.pem \
        --with-libunistring-prefix=/opt/pacman \
        --disable-static \
        --enable-shared \
        --disable-doc \
        --disable-tests \
        --disable-guile \
        --without-tpm \
        --without-tpm2
    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/gnutls-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    /opt/pacman/bin/install -Dm644 LICENSE "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
