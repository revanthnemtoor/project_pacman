pkgname=links
pkgver=2.30
pkgrel=2
pkgdesc="Lynx-like WWW browser that supports tables, menus, etc."

url="https://links.twibright.com/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'GPL-2.0-or-later WITH cryptsetup-OpenSSL-exception'
)
depends=(
    'openssl'
)
makedepends=(
    'pkgconf'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}