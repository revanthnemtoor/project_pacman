# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=zstd
pkgver=1.5.7
pkgrel=2
pkgdesc="Zstandard - fast real-time compression algorithm"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://facebook.github.io/zstd/"
license=('BSD-3-Clause' 'GPL-2.0-only')
depends=('zlib' 'xz' 'lz4')
options=('!strip' '!debug' '!libtool')
source=("https://github.com/facebook/zstd/releases/download/v${pkgver}/zstd-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  export PATH="/opt/pacman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  local _cmake
  _cmake="$(command -v cmake)"
  cd "${srcdir}/zstd-${pkgver}"
  "${_cmake}" -S build/cmake -B _build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/pacman \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_BUILD_WITH_INSTALL_NAME_DIR=ON \
    -DCMAKE_INSTALL_NAME_DIR=/opt/pacman/lib \
    -DCMAKE_INSTALL_RPATH=/opt/pacman/lib \
    -DCMAKE_PREFIX_PATH=/opt/pacman \
    -DZSTD_BUILD_PROGRAMS=ON \
    -DZSTD_BUILD_SHARED=ON \
    -DZSTD_BUILD_STATIC=ON \
    -DZSTD_PROGRAMS_LINK_SHARED=OFF \
    -DZSTD_ZLIB_SUPPORT=ON \
    -DZSTD_LZMA_SUPPORT=ON \
    -DZSTD_LZ4_SUPPORT=ON
  "${_cmake}" --build _build -j "$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
}

package() {
  export PATH="/opt/pacman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  local _cmake
  _cmake="$(command -v cmake)"
  cd "${srcdir}/zstd-${pkgver}"
  DESTDIR="${pkgdir}" "${_cmake}" --install _build
  rm -f "${pkgdir}/opt/pacman/lib/libzstd.a"
  mkdir -p "${pkgdir}/opt/pacman/share/licenses/${pkgname}"
  cp -f LICENSE "${pkgdir}/opt/pacman/share/licenses/${pkgname}/LICENSE"
  if [ -d "${pkgdir}/opt/pacman" ]; then
    find "${pkgdir}/opt/pacman" -type f \( -perm -111 -o -name "*.dylib" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do
      if /usr/bin/file "$f" 2>/dev/null | grep -q "Mach-O"; then
        /usr/bin/codesign --force --sign - "$f" 2>/dev/null || true
      fi
    done
  fi
}
