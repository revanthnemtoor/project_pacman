# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=fakeroot
pkgver=1.37.1.1
pkgrel=1
pkgdesc="Tool for simulating superuser privileges on Darwin/POSIX during packaging"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://tracker.debian.org/pkg/fakeroot"
license=('GPL-3.0-or-later')
depends=('bash')
options=('!strip' '!libtool')
source=("https://deb.debian.org/debian/pool/main/f/fakeroot/fakeroot_${pkgver}.orig.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/fakeroot-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk} -D_DARWIN_C_SOURCE -DSOL_TCP=IPPROTO_TCP"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk} -Wno-deprecated-declarations -Wno-implicit-function-declaration -Wno-int-conversion -Wno-incompatible-function-pointer-types -Wno-incompatible-pointer-types"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    if [[ ! -x ./configure ]]; then
        ./bootstrap
    fi

    ./configure \
        --prefix=/opt/pacman \
        --libdir=/opt/pacman/lib/libfakeroot \
        --disable-static \
        --with-ipc=tcp

    make -j"$(sysctl -n hw.ncpu)" WRAPPED_NOLIB64=1 || make
}

package() {
    cd "$srcdir/fakeroot-${pkgver}"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
