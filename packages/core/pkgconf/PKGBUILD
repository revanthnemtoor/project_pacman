# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=pkgconf
pkgver=2.3.0
pkgrel=1
pkgdesc="Package compiler and linker metadata toolkit"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/pkgconf/pkgconf"
license=('ISC')
options=('!strip' '!debug' '!libtool')
source=("https://distfiles.ariadne.space/pkgconf/pkgconf-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  export PATH="/opt/pacman/bin:/opt/homebrew/bin:/opt/homebrew/opt/gettext/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
  export CPPFLAGS="-I/opt/pacman/include"
  export CFLAGS="-O2 -I/opt/pacman/include"
  export CXXFLAGS="-O2 -I/opt/pacman/include"
  export LDFLAGS="-L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib"
  local _jobs
  _jobs="$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
  cd "${srcdir}/pkgconf-${pkgver}"
  ./configure --prefix=/opt/pacman --with-pkg-config-dir=/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig --with-system-libdir=/usr/lib --with-system-includedir=/usr/include --disable-static
  make -j"${_jobs}"
}

package() {
  cd "${srcdir}/pkgconf-${pkgver}"
  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/opt/pacman/share/info/dir" "${pkgdir}"/opt/pacman/lib/*.la
  ln -sf pkgconf "${pkgdir}/opt/pacman/bin/pkg-config"
  if [ -d "${pkgdir}/opt/pacman" ]; then
    find "${pkgdir}/opt/pacman" -type f \( -perm -111 -o -name "*.dylib" -o -name "*.so" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do
      if /usr/bin/file "$f" 2>/dev/null | grep -q "Mach-O"; then
        /usr/bin/codesign --force --sign - "$f" 2>/dev/null || true
      fi
    done
  fi
}
