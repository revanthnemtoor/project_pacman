pkgname=gmp
pkgver=6.3.0
pkgrel=1
pkgdesc="GNU multiple precision arithmetic library"

url="https://gmplib.org/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'LGPL-3.0-or-later OR GPL-2.0-or-later'
)
makedepends=(
    'autoconf'
    'automake'
    'libtool'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}