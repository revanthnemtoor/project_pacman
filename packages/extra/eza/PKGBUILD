# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=eza
pkgver=0.23.5
pkgrel=1
pkgdesc="A modern replacement for ls (community fork of exa)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/eza-community/eza"
license=('MIT')
depends=('zlib')
options=('!strip')
source=("https://github.com/eza-community/eza/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/eza-${pkgver}"
    local _sdk="$(xcrun --show-sdk-path)"
    local _cargo="/opt/pacman/bin/cargo"
    [[ ! -x "$_cargo" ]] && _cargo="/opt/local/bin/cargo"
    export PATH="/opt/pacman/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CC="/usr/bin/clang"
    export SDKROOT="${_sdk}"
    export LIBGIT2_NO_VENDOR=0
    export RUSTFLAGS="-C link-arg=-Wl,-rpath,/opt/pacman/lib -C link-arg=-L/opt/pacman/lib"

    "$_cargo" build --release --locked
}

package() {
    cd "$srcdir/eza-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    /opt/pacman/bin/install -Dm755 target/release/eza "$pkgdir/opt/pacman/bin/eza"
    /usr/bin/strip -x "$pkgdir/opt/pacman/bin/eza" 2>/dev/null || true
    /usr/bin/codesign --force --sign - "$pkgdir/opt/pacman/bin/eza"
    for lf in LICENSE LICENSE.txt LICENCE; do
        [ -f "$lf" ] && /opt/pacman/bin/install -Dm644 "$lf" "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE" && break
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
