# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=just
pkgver=1.59.0
pkgrel=1
pkgdesc="A handy way to save and run project-specific commands"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/casey/just"
license=('CC0-1.0')
options=('!strip')
source=("https://github.com/casey/just/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/just-${pkgver}"
    local _sdk="$(xcrun --show-sdk-path)"
    local _cargo="/opt/pacman/bin/cargo"
    [[ ! -x "$_cargo" ]] && _cargo="/opt/local/bin/cargo"
    export PATH="/opt/pacman/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export SDKROOT="${_sdk}"
    export RUSTFLAGS="-C link-arg=-Wl,-rpath,/opt/pacman/lib -C link-arg=-L/opt/pacman/lib"

    "$_cargo" build --release --locked
}

package() {
    cd "$srcdir/just-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    /opt/pacman/bin/install -Dm755 target/release/just "$pkgdir/opt/pacman/bin/just"
    /usr/bin/strip -x "$pkgdir/opt/pacman/bin/just" 2>/dev/null || true
    /usr/bin/codesign --force --sign - "$pkgdir/opt/pacman/bin/just"
    /opt/pacman/bin/install -Dm644 LICENSE "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
