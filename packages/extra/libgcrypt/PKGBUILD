pkgname=libgcrypt
pkgver=1.12.4
pkgrel=1
pkgdesc="Cryptographic library based on the code from GnuPG"

url="https://gnupg.org/related_software/libgcrypt/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'LGPL-2.1-or-later AND GPL-2.0-or-later'
)
depends=(
    'libgpg-error'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}