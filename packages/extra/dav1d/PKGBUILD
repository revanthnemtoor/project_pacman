# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
# Native macOS port for Pacman (/opt/pacman)
pkgname=dav1d
pkgver=1.5.5
pkgrel=1
pkgdesc="AV1 cross-platform decoder focused on speed and correctness"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://code.videolan.org/videolan/dav1d"
license=('BSD-2-Clause')
provides=('libdav1d.dylib')
options=('!strip' '!libtool')
source=("https://code.videolan.org/videolan/dav1d/-/archive/${pkgver}/dav1d-${pkgver}.tar.bz2")
sha256sums=('SKIP')

build() {
    cd "$srcdir/dav1d-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"

    export PATH="/opt/pacman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"

    /usr/local/bin/meson setup build \
        --prefix=/opt/pacman \
        --libdir=lib \
        --buildtype=release \
        --default-library=shared \
        -Denable_tests=false \
        -Denable_tools=false \
        -Denable_docs=false

    /usr/local/bin/ninja -C build
}

package() {
    cd "$srcdir/dav1d-${pkgver}"
    DESTDIR="$pkgdir" /usr/local/bin/ninja -C build install
    install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"

    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
