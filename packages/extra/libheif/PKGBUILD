# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
# Native macOS port for Pacman (/opt/pacman)
pkgname=libheif
pkgver=1.23.7
pkgrel=3
pkgdesc="An HEIF and AVIF file format decoder and encoder"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/strukturag/libheif"
license=('LGPL-3.0-or-later')
depends=('aom' 'brotli' 'dav1d' 'kvazaar' 'libde265' 'libjpeg-turbo' 'libpng' 'libtiff' 'libwebp' 'openjpeg2' 'zlib')
provides=('libheif.dylib')
options=('!strip' '!libtool')
source=("https://github.com/strukturag/libheif/releases/download/v${pkgver}/libheif-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    local _cmake="/opt/pacman/bin/cmake"
    for _c in /opt/pacman/bin/cmake /opt/homebrew/bin/cmake /usr/local/bin/cmake /opt/local/bin/cmake "$(command -v cmake 2>/dev/null)"; do [[ -x "$_c" ]] && { _cmake="$_c"; break; }; done

    export PATH="/opt/pacman/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"

    "$_cmake" -B build -S "libheif-${pkgver}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pacman \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_NAME_DIR=/opt/pacman/lib \
        -DCMAKE_INSTALL_RPATH=/opt/pacman/lib \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_OSX_ARCHITECTURES="${_arch}" \
        -DCMAKE_OSX_SYSROOT="${_sdk}" \
        -DCMAKE_PREFIX_PATH=/opt/pacman \
        -DCMAKE_SYSTEM_PREFIX_PATH="/opt/pacman;${_sdk}/usr" \
        -DCMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH=OFF \
        -DCMAKE_C_COMPILER=/usr/bin/clang \
        -DCMAKE_CXX_COMPILER=/usr/bin/clang++ \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DWITH_EXAMPLES=ON \
        -DCMAKE_DISABLE_FIND_PACKAGE_SDL2=ON \
        -DWITH_GDK_PIXBUF=OFF \
        -DENABLE_PLUGIN_LOADING=OFF \
        -DWITH_LIBDE265=ON \
        -DWITH_AOM_DECODER=ON \
        -DWITH_AOM_ENCODER=ON \
        -DWITH_DAV1D=ON \
        -DWITH_JPEG_DECODER=ON \
        -DWITH_JPEG_ENCODER=ON \
        -DWITH_OpenJPEG_DECODER=ON \
        -DWITH_OpenJPEG_ENCODER=ON \
        -DWITH_RAV1E=OFF \
        -DWITH_SvtEnc=OFF \
        -DWITH_X265=OFF \
        -DWITH_X264=OFF \
        -DWITH_OpenH264_DECODER=OFF \
        -DWITH_KVAZAAR=ON \
        -DWITH_UVG266=OFF \
        -DWITH_VVDEC=OFF \
        -DWITH_VVENC=OFF \
        -DWITH_FFMPEG_DECODER=OFF \
        -DWITH_LIBSHARPYUV=ON

    "$_cmake" --build build -j"$(sysctl -n hw.ncpu)"
}

package() {
    local _cmake="/opt/pacman/bin/cmake"
    for _c in /opt/pacman/bin/cmake /opt/homebrew/bin/cmake /usr/local/bin/cmake /opt/local/bin/cmake "$(command -v cmake 2>/dev/null)"; do [[ -x "$_c" ]] && { _cmake="$_c"; break; }; done
    DESTDIR="$pkgdir" "$_cmake" --install build
    install -Dm644 "$srcdir/libheif-${pkgver}/COPYING" \
        "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"

    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
