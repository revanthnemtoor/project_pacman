# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=ninja
pkgver=1.13.2
pkgrel=1
pkgdesc="Small build system with a focus on speed"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://ninja-build.org/"
license=('Apache-2.0')
depends=('python')
options=('!strip')
source=("https://github.com/ninja-build/ninja/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/ninja-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CXX="/usr/bin/clang++"
    export CFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export CXXFLAGS="-O2 -arch ${_arch} -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    if [[ "$(uname -m)" != "${_arch}" ]] && [[ -x /opt/pacman/bin/ninja ]]; then
        /opt/pacman/bin/python3 configure.py
        /opt/pacman/bin/ninja -j"$(sysctl -n hw.ncpu)"
    else
        /opt/pacman/bin/python3 configure.py --bootstrap --verbose
    fi
}

package() {
    cd "$srcdir/ninja-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    /opt/pacman/bin/install -Dm755 ninja "$pkgdir/opt/pacman/bin/ninja"
    /opt/pacman/bin/install -Dm644 misc/bash-completion "$pkgdir/opt/pacman/share/bash-completion/completions/ninja"
    /opt/pacman/bin/install -Dm644 misc/zsh-completion "$pkgdir/opt/pacman/share/zsh/site-functions/_ninja"
    /opt/pacman/bin/install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    /usr/bin/codesign --force --sign - "$pkgdir/opt/pacman/bin/ninja"
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
