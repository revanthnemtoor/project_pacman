# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=fish
pkgver=4.0.0
pkgrel=1
pkgdesc="Smart and user friendly shell intended mostly for interactive use"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://fishshell.com/"
license=('GPL-2.0-only')
options=('!strip' '!debug')
source=("https://github.com/fish-shell/fish-shell/releases/download/${pkgver}/fish-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  local _cmake
  _cmake="$(PATH="/opt/pacman/bin:/opt/homebrew/bin:/usr/local/bin:$PATH" command -v cmake)"
  export PATH="/opt/pacman/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  cd "${srcdir}/fish-${pkgver}"
  "${_cmake}" -B _build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/pacman -DCMAKE_PREFIX_PATH=/opt/pacman
  "${_cmake}" --build _build -j "$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
}

package() {
  local _cmake
  _cmake="$(PATH="/opt/pacman/bin:/opt/homebrew/bin:/usr/local/bin:$PATH" command -v cmake)"
  cd "${srcdir}/fish-${pkgver}"
  DESTDIR="${pkgdir}" "${_cmake}" --install _build
  if [ -d "${pkgdir}/opt/pacman" ]; then
    find "${pkgdir}/opt/pacman" -type f \( -perm -111 -o -name "*.dylib" -o -name "*.so" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do
      if /usr/bin/file "$f" 2>/dev/null | grep -q "Mach-O"; then
        /usr/bin/codesign --force --sign - "$f" 2>/dev/null || true
      fi
    done
  fi
}
