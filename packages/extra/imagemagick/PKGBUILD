# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
# Native macOS port for Pacman (/opt/pacman)
pkgname=imagemagick
pkgver=7.1.2.36
pkgrel=1
pkgdesc="An image viewing/manipulation program (macOS native)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://imagemagick.org/"
license=('ImageMagick')
depends=('lcms2' 'libjpeg-turbo' 'libpng' 'libtiff' 'xz' 'zlib' 'zstd')
options=('!strip')
source=()
sha256sums=()

prepare() {
    rm -rf "$srcdir/ImageMagick"
    cp -a "/Users/revanth/Projects/imagemagick/ImageMagick" "$srcdir/ImageMagick"
    rm -rf "$srcdir/ImageMagick/.git"
}

build() {
    cd "$srcdir/ImageMagick"

    local _arch="x86_64"
    if [[ "$CARCH" == "darwin_arm64" ]]; then
        _arch="arm64"
    fi

    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export CXX="/usr/bin/clang++"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CPPFLAGS="-I/opt/pacman/include"
    export CFLAGS="-O2 -arch $_arch -I/opt/pacman/include"
    export CXXFLAGS="-O2 -arch $_arch -I/opt/pacman/include"
    export LDFLAGS="-arch $_arch -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib"

    chmod +x ./configure
    ./configure \
        --prefix=/opt/pacman \
        --sysconfdir=/opt/pacman/etc \
        --mandir=/opt/pacman/share/man \
        --enable-shared \
        --disable-static \
        --enable-hdri \
        --with-quantum-depth=16 \
        --disable-openmp \
        --without-modules \
        --without-x \
        --without-perl \
        --with-magick-plus-plus=yes \
        --with-png=yes \
        --with-jpeg=yes \
        --with-tiff=yes \
        --with-lcms=yes \
        --with-zlib=yes \
        --with-lzma=yes \
        --with-zstd=yes

    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/ImageMagick"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete
    install -Dm644 "$srcdir/ImageMagick/LICENSE" \
        "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"

    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done

    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
