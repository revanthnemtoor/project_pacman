# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=tree
pkgver=2.2.1
pkgrel=1
pkgdesc="Directory listing program displaying a depth indented list of files"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://oldmanprogrammer.net/source.php?dir=projects/tree"
license=('GPL-2.0-or-later')
options=('!strip' '!debug' '!libtool')
source=("https://gitlab.com/OldManProgrammer/unix-tree/-/archive/${pkgver}/unix-tree-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/unix-tree-${pkgver}"
  make CC="${CC:-/usr/bin/clang}" CFLAGS="-O2 -Wall" LDFLAGS="" -j"$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
}

package() {
  cd "${srcdir}/unix-tree-${pkgver}"
  make PREFIX="${pkgdir}/opt/pacman" MANDIR="${pkgdir}/opt/pacman/share/man" install
  if [ -d "${pkgdir}/opt/pacman" ]; then
    find "${pkgdir}/opt/pacman" -type f \( -perm -111 -o -name "*.dylib" -o -name "*.so" \) -print0 2>/dev/null | while IFS= read -r -d '' f; do
      if /usr/bin/file "$f" 2>/dev/null | grep -q "Mach-O"; then
        /usr/bin/codesign --force --sign - "$f" 2>/dev/null || true
      fi
    done
  fi
}
