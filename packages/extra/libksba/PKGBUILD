pkgname=libksba
pkgver=1.8.1
pkgrel=1
pkgdesc="X.509 and CMS library"

url="https://www.gnupg.org/related_software/libksba/"
arch=(
    'darwin_arm64'
    'darwin_x86_64'
)
license=(
    'LGPL-3.0-or-later OR GPL-2.0-or-later'
)
depends=(
    'libgpg-error'
)
options=('!strip')
source=()
sha256sums=()

package() {
    local _stage="$startdir/stage"
    local _dest="$pkgdir/opt/pacman"
    mkdir -p "$_dest"

    local _dirs=(bin sbin lib lib64 include share etc var libexec)
    for _d in "${_dirs[@]}"; do
        if [ -d "$_stage/$_d" ]; then
            cp -a "$_stage/$_d" "$_dest/"
        fi
    done
}