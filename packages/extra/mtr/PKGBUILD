# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=mtr
pkgver=0.96
pkgrel=1
pkgdesc="Combines the functionality of traceroute and ping into a single network diagnostic tool"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://www.bitwizard.nl/mtr/"
license=('GPL-2.0-only')
depends=('ncurses' 'jansson')
options=('!strip')
source=("https://github.com/traviscross/mtr/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/mtr-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -I/opt/pacman/include/ncursesw -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -lresolv -isysroot ${_sdk}"

    echo "${pkgver}" > .tarball-version
    ./bootstrap.sh
    ./configure --prefix=/opt/pacman --sbindir=/opt/pacman/bin --without-gtk --with-ncurses --with-jansson --disable-bash-completion
    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/mtr-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    make DESTDIR="$pkgdir" install
    /opt/pacman/bin/install -Dm644 COPYING "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    for f in "$pkgdir"/opt/pacman/bin/*; do
        [ -f "$f" ] && ! [ -L "$f" ] && /usr/bin/codesign --force --sign - "$f" || true
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
