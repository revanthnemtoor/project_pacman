# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=sd
pkgver=1.1.0
pkgrel=1
pkgdesc="Intuitive find & replace CLI (sed alternative)"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/chmln/sd"
license=('MIT')
options=('!strip')
source=("https://github.com/chmln/sd/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/sd-${pkgver}"
    local _sdk="$(xcrun --show-sdk-path)"
    local _cargo="/opt/pacman/bin/cargo"
    for _cg in /opt/pacman/bin/cargo "$HOME/.cargo/bin/cargo" /opt/homebrew/bin/cargo /usr/local/bin/cargo /opt/local/bin/cargo "$(command -v cargo 2>/dev/null)"; do [[ -x "$_cg" ]] && { _cargo="$_cg"; break; }; done
    export PATH="/opt/pacman/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export SDKROOT="${_sdk}"
    export RUSTFLAGS="-C link-arg=-Wl,-rpath,/opt/pacman/lib -C link-arg=-L/opt/pacman/lib"

    "$_cargo" build --release --locked
}

package() {
    cd "$srcdir/sd-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    /opt/pacman/bin/install -Dm755 target/release/sd "$pkgdir/opt/pacman/bin/sd"
    /usr/bin/strip -x "$pkgdir/opt/pacman/bin/sd" 2>/dev/null || true
    /usr/bin/codesign --force --sign - "$pkgdir/opt/pacman/bin/sd"
    /opt/pacman/bin/install -Dm644 LICENSE "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
