# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=chafa
pkgver=1.18.3
pkgrel=1
pkgdesc="Image-to-text terminal graphics converter supporting Sixel, Kitty, iTerm2, and Unicode"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://hpjansson.org/chafa/"
license=('LGPL-3.0-or-later')
depends=('glib2' 'freetype2' 'libjpeg-turbo' 'libtiff' 'libwebp')
options=('!strip')
source=("https://hpjansson.org/chafa/releases/chafa-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/chafa-${pkgver}"
    local _arch="x86_64"
    [[ "$CARCH" == "darwin_arm64" ]] && _arch="arm64"
    local _sdk="$(xcrun --show-sdk-path)"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export PKG_CONFIG="/opt/pacman/bin/pkg-config"
    export PKG_CONFIG_PATH="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export PKG_CONFIG_LIBDIR="/opt/pacman/lib/pkgconfig:/opt/pacman/share/pkgconfig"
    export CC="/usr/bin/clang"
    export CPPFLAGS="-I/opt/pacman/include -isysroot ${_sdk}"
    export CFLAGS="-O2 -arch ${_arch} -I/opt/pacman/include -isysroot ${_sdk}"
    export LDFLAGS="-arch ${_arch} -L/opt/pacman/lib -Wl,-rpath,/opt/pacman/lib -isysroot ${_sdk}"

    ./configure --prefix=/opt/pacman --without-avif --without-svg --without-jxl --disable-man
    make -j"$(sysctl -n hw.ncpu)"
}

package() {
    cd "$srcdir/chafa-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    make DESTDIR="$pkgdir" install
    find "$pkgdir/opt/pacman/lib" -name '*.la' -delete 2>/dev/null || true
    /opt/pacman/bin/install -Dm644 COPYING.LESSER "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    find "$pkgdir/opt/pacman" -type f ! -type l | while IFS= read -r f; do
        if /usr/bin/file -b "$f" | grep -q "Mach-O"; then
            /usr/bin/codesign --force --sign - "$f"
        fi
    done
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
