# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=hyperfine
pkgver=2.0.0
pkgrel=1
pkgdesc="A command-line benchmarking tool"
arch=('darwin_x86_64' 'darwin_arm64')
url="https://github.com/sharkdp/hyperfine"
license=('MIT OR Apache-2.0')
options=('!strip')
source=("https://github.com/sharkdp/hyperfine/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/hyperfine-${pkgver}"
    local _sdk="$(xcrun --show-sdk-path)"
    local _cargo="/opt/pacman/bin/cargo"
    [[ ! -x "$_cargo" ]] && _cargo="/opt/local/bin/cargo"
    export PATH="/opt/pacman/bin:/opt/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    export CC="/usr/bin/clang"
    export SDKROOT="${_sdk}"
    export RUSTFLAGS="-C link-arg=-Wl,-rpath,/opt/pacman/lib -C link-arg=-L/opt/pacman/lib"

    "$_cargo" build --release --locked
}

package() {
    cd "$srcdir/hyperfine-${pkgver}"
    export PATH="/opt/pacman/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    /opt/pacman/bin/install -Dm755 target/release/hyperfine "$pkgdir/opt/pacman/bin/hyperfine"
    /usr/bin/strip -x "$pkgdir/opt/pacman/bin/hyperfine" 2>/dev/null || true
    /usr/bin/codesign --force --sign - "$pkgdir/opt/pacman/bin/hyperfine"
    [ -f doc/hyperfine.1 ] && /opt/pacman/bin/install -Dm644 doc/hyperfine.1 "$pkgdir/opt/pacman/share/man/man1/hyperfine.1" || true
    /opt/pacman/bin/install -Dm644 LICENSE-MIT "$pkgdir/opt/pacman/share/licenses/$pkgname/LICENSE"
    chgrp -R admin "$pkgdir" 2>/dev/null || true
}
