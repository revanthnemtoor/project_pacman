# Maintainer: Revanth Reddy Nemtoor <developerrevanth123@gmail.com>
pkgname=zlib
pkgver=1.3.1
pkgrel=1
pkgdesc="Compression library implementing the deflate compression method found in gzip and PKZIP"
arch=('darwin_x86_64' 'darwin_arm64' 'x86_64' 'arm64')
url="https://zlib.net/"
license=('Zlib')
depends=()
source=("https://github.com/madler/zlib/releases/download/v${pkgver}/zlib-${pkgver}.tar.gz")
sha256sums=('9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23')
options=('!strip')

build() {
  cd "$srcdir/zlib-$pkgver"
  export CFLAGS="-O3 -arch x86_64 -arch arm64"
  export LDFLAGS="-arch x86_64 -arch arm64"
  ./configure --prefix=/opt/pacman
  make -j$(sysctl -n hw.ncpu)
}

package() {
  cd "$srcdir/zlib-$pkgver"
  make DESTDIR="$pkgdir" install

  # Codesign all dylibs
  find "$pkgdir/opt/pacman" -type f -name "*.dylib*" -exec codesign --sign - --force {} + 2>/dev/null || true
}
